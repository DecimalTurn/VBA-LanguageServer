// A launch configuration that compiles the extension and then opens it inside a new window
// -*- mode: jsonc -*-
{
	"version": "0.2.0",
	"configurations": [
		{
			// Opens a new Extension Development Host window and loads this extension from the workspace.
			"type": "extensionHost",
			"request": "launch",
			"name": "Launch Client",
			"preLaunchTask": "watch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}",
				"${workspaceFolder}/sample/project"
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceRoot}/dist/client/out/**/*.js"],
		},
		{
			// Same as Launch Client, but opens test fixtures to quickly exercise parser/diagnostic scenarios.
			"type": "extensionHost",
			"request": "launch",
			"name": "Launch Client (Fixtures)",
			"preLaunchTask": "watch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}",
				"${workspaceFolder}/test/fixtures"
			],
			"sourceMaps": true,
			"outFiles": ["${workspaceRoot}/dist/client/out/**/*.js"],
		},
		{
			// Attaches to the language server Node process started by client/src/extension.ts in debug mode
			// (debug options use --inspect=6009).
			"type": "node",
			"request": "attach",
			"name": "Attach to Server",
			"port": 6009,
			"timeout": 60000,
			"cwd": "${workspaceFolder}",
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/server/out/**/*.js"
			],
			// Uncomment these when server breakpoints bind to generated/dependency code,
			// or when source-map resolution becomes slow/ambiguous in attach mode.
			// They restrict map resolution to our built server output and map relative
			// source paths back to workspace files deterministically.
			// "resolveSourceMapLocations": [
			// 	"${workspaceFolder}/dist/server/out/**/*.js",
			// 	"!**/node_modules/**"
			// ],
			"restart": true,
		},
		{
			"name": "Language Server E2E Test",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}",
				"--extensionTestsPath=${workspaceRoot}/dist/client/out/test/index",
				"${workspaceRoot}/test/fixtures"
			],
			"outFiles": [
				"${workspaceRoot}/dist/client/out/test/**/*.js"
			]
		},
		{
			"name": "Run Web Extension in VS Code",
			"type": "extensionHost",
			"debugWebWorkerHost": true,
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionDevelopmentKind=web"
			],
			"outFiles": [
				"${workspaceFolder}/dist/web/*.js"
			]
		},
		{
			"name": "Debug ANTLR4 grammar",
			"type": "antlr-debug",
			"request": "launch",
			"input": "${file}",
			"grammar": "server/src/antlr/vba.g4",
			"startRule": "startRule",
			"printParseTree": true,
			"visualParseTree": true
		},
		{
			"name": "Debug ANTLR4 Pre grammar",
			"type": "antlr-debug",
			"request": "launch",
			"input": "${file}",
			"grammar": "server/src/antlr/vbapre.g4",
			"startRule": "startRule",
			"printParseTree": true,
			"visualParseTree": true
		},
		{
			"name": "Debug ANTLR4 Fmt grammar",
			"type": "antlr-debug",
			"request": "launch",
			"input": "${file}",
			"grammar": "server/src/antlr/vbafmt.g4",
			"startRule": "startRule",
			"printParseTree": true,
			"visualParseTree": true
		},
		{
			"name": "Extension Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionTestsPath=${workspaceFolder}/dist/client/out/test/index"
			],
			"outFiles": [
				"${workspaceFolder}/dist/client/out/test/**/*.test.js"
			]
		}
	],
	"compounds": [
		{
			"name": "Client + Server",
			"configurations": [
				"Launch Client",
				"Attach to Server"
			],
			"stopAll": true
		},
		{
			"name": "Client + Server (Fixtures)",
			"configurations": [
				"Launch Client (Fixtures)",
				"Attach to Server"
			],
			"stopAll": true
		},
	]
}