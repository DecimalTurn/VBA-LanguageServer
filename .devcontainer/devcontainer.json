{
	"image": "mcr.microsoft.com/devcontainers/typescript-node:22",
	"features": {
		// Java needed to run ANTLR
		"ghcr.io/roul/devcontainer-features/mise-java:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"EditorConfig.EditorConfig",
				"mike-lischke.vscode-antlr4",
				"RedCMD.tmlanguage-syntax-highlighter",
				"github.vscode-github-actions"
			]
		}
	},
	"postCreateCommand": "bash ./.devcontainer/setup.sh",
	"postAttachCommand": "test -f ./.codespace-setup-success && echo 'Setup complete! You can now run \"npm run testsh\" to execute e2e tests in the headless environment.'"
}